{
  "name": "photo-editor",
  "productName": "Photo Editor",
  "version": "1.0.0",
  "description": "A standalone desktop photo editor for Windows",
  "main": "src/main.js",
  "author": "IndyTopSeal",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "fabric": "^5.3.0"
  },
  "build": {
    "appId": "com.indytopseal.photoeditor",
    "productName": "Photo Editor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
